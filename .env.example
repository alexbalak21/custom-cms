APP_NAME="Custom CMS"
APP_URL=http://localhost:8000
APP_BASE_PATH=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=custom_cms
DB_USERNAME=root
DB_PASSWORD=

# Admin session binding: strict (same IP) | subnet (same /24 or /64) | off
SESSION_IP_CHECK=subnet
SESSION_IDLE_MINUTES=120
SESSION_LIFETIME_HOURS=12

# Mail: MAIL_DRIVER = log (writes storage/mail.log, for dev) | smtp | mail (PHP mail())
MAIL_DRIVER=log
MAIL_HOST=smtp.example.com
MAIL_PORT=587
# MAIL_ENCRYPTION = tls (STARTTLS, port 587) | ssl (port 465) | none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Custom CMS"
# Default recipient for the seeded contact form
MAIL_TO=contact@example.com

# Secret used to sign form tokens. Generate with: php cms key:generate
APP_KEY=
FORM_RATE_LIMIT=5
